# Server
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/domovault

# CORS - explicit allow-list, never "*" (frontend origin only; browser never calls this API directly)
CORS_ORIGIN=http://localhost:3000

# JWT - single algorithm only (HS256). Never change this without rotating every signing path.
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-bytes
JWT_REFRESH_EXPIRES_IN=15d
JWT_MFA_SECRET=replace-with-yet-another-long-random-secret-min-32-bytes
JWT_MFA_EXPIRES_IN=5m

# AES-256-GCM key for encrypting sensitive PII at rest. Must be exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# CAPTCHA - required once an account hits CAPTCHA_TRIGGER_THRESHOLD failed
# logins. "none" leaves it off (fine for local dev). Set to "hcaptcha" or
# "recaptcha" in production and provide CAPTCHA_SECRET_KEY from that provider.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
CAPTCHA_TRIGGER_THRESHOLD=5

# Application base URL - used when building links so they are never derived
# from req.headers.host (host-header attack prevention).
APP_URL=http://localhost:3000

# Local file upload storage path (outside web root). In Docker this should
# be a named volume mount so uploads survive container rebuilds.
UPLOAD_DIR=uploads

# Optional comma-separated domain allow-list for outbound URL fetches
# (property photo import from URL). Leave empty to block all URL imports.
SSRF_ALLOWED_DOMAINS=

# Optional admin seed (development only; never set in production).
# If set, an admin user with this email+password is created on first startup.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
