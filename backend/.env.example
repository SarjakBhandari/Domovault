# Server
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/domovault

# CORS - explicit allow-list, never "*" (frontend origin only; browser never calls this API directly)
# Use https://localhost when running via docker compose (nginx TLS termination).
# Use http://localhost:3000 for local npm run dev only.
CORS_ORIGIN=https://localhost

# JWT - single algorithm only (HS256). Never change this without rotating every signing path.
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-bytes
JWT_REFRESH_EXPIRES_IN=15d
JWT_MFA_SECRET=replace-with-yet-another-long-random-secret-min-32-bytes
JWT_MFA_EXPIRES_IN=5m

# Dedicated HMAC key for CSRF double-submit tokens. Must be at least 32 chars.
# Separate from JWT secrets so rotating JWTs never invalidates CSRF tokens.
CSRF_SECRET=replace-with-another-long-random-secret-min-32-bytes

# AES-256-GCM key for encrypting sensitive PII at rest. Must be exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Application base URL - used when building links so they are never derived
# from req.headers.host (host-header attack prevention).
APP_URL=http://localhost:3000

# Local file upload storage path (outside web root). In Docker this should
# be a named volume mount so uploads survive container rebuilds.
UPLOAD_DIR=uploads

# Rate limiting - tune these if the defaults are too tight for your environment.
# General limiter applies to all routes; auth limiter is stricter and covers
# login/register/reset/MFA endpoints. Both are disabled in NODE_ENV=test.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Optional admin seed (development only; never set in production).
# If set, an admin user with this email+password is created on first startup.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# SMTP (Nodemailer) - transactional email for verification and password reset.
# For local dev, point at MailHog or Mailpit (port 1025, no auth needed).
# Set SMTP_SECURE=true and add credentials for production SMTP providers.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@domovault.local
